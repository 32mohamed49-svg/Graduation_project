# ==============================================================================
# Cognitive Supply Chain Environment Configuration Example
# Copy this file to .env and fill in real values locally. Never commit .env.
# ==============================================================================

# --- Application ---
APP_NAME=CognitiveSupplyChain
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Docker / Service Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173
POSTGRES_PORT=5432
N8N_PORT=5678

# --- Factory / Operational Database (PostgreSQL) ---
# Use "postgres" inside Docker Compose; use "localhost" when running scripts locally
POSTGRES_HOST=postgres
POSTGRES_DB=cognitive_supply_chain
POSTGRES_USER=supply_chain_user
POSTGRES_PASSWORD=replace_with_postgres_password
DATABASE_URL=postgresql://supply_chain_user:replace_with_postgres_password@postgres:5432/cognitive_supply_chain

# --- External Factor APIs (Weather & Traffic) ---
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=replace_with_weather_api_key
TRAFFIC_API_BASE_URL=https://api.example-traffic.com/v1
TRAFFIC_API_KEY=replace_with_traffic_api_key

# --- ML Forecasting & Problem Detection ---
MODEL_ARTIFACTS_DIR=/app/models
FORECAST_HORIZON_DAYS=14
SHORTAGE_ALERT_THRESHOLD_DAYS=4

# --- AI Agent (LangGraph / CrewAI) ---
AGENT_FRAMEWORK=langgraph
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Execution & Automation (n8n, Email, Notion) ---
N8N_HOST=n8n
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678/webhook/purchase-order
N8N_API_KEY=replace_with_n8n_api_key
N8N_ENCRYPTION_KEY=replace_with_n8n_encryption_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
NOTION_API_KEY=replace_with_notion_api_key
NOTION_DATABASE_ID=replace_with_notion_database_id

# --- Frontend / Dashboard ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
