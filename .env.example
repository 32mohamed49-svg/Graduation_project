# ==============================================================================
# HAQI Environment Configuration Example
# Copy this file to .env and fill in real values locally. Never commit .env.
# ==============================================================================

# --- Application ---
APP_NAME=HAQI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Docker / Service Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Qdrant Vector Database ---
# Use "qdrant" inside Docker Compose; use "localhost" when running scripts locally
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=replace_with_qdrant_api_key
QDRANT_COLLECTION_NAME=haqi_civil_status
QDRANT__SERVICE__API_KEY=replace_with_qdrant_api_key

# --- Embeddings ---
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32

# --- LLM Generation ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- RAG Pipeline ---
MVP_DOMAIN=civil_status
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.5

# --- Frontend (Vite build & dev) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

